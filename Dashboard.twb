    <worksheet name='Sheet 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Revenue&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='olist_customers_dataset' name='federated.0pcm7q81nhytxn1guf4tk168yag2' />
          </datasources>
          <datasource-dependencies datasource='federated.0pcm7q81nhytxn1guf4tk168yag2'>
            <column caption='Total Revenue' datatype='real' name='[Calculation_1895895714963459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [order_status] = &quot;delivered&quot;&#13;&#10;        THEN [price]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column-instance column='[pruchase_date]' derivation='Month' name='[mn:pruchase_date:ok]' pivot='key' type='ordinal' />
