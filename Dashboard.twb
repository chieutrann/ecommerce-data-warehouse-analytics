            <column-instance column='[Calculation_1895895714963459]' derivation='Sum' name='[sum:Calculation_1895895714963459:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pruchase_date]' derivation='Day-Trunc' name='[tdy:pruchase_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[pruchase_date]' derivation='Year' name='[yr:pruchase_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0pcm7q81nhytxn1guf4tk168yag2].[mn:pruchase_date:ok]</column>
