      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_1895895714963459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [order_status] = &quot;delivered&quot;&#13;&#10;        THEN [price]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Repeat Purchase Rate' datatype='real' default-format='p0.0000%' name='[Calculation_1895895719768069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_repeat_customer])/ COUNT([is_repeat_customer])' />
      </column>
      <column caption='On-Time Delivery Rate' datatype='real' default-format='p0.0%' name='[Calculation_1895895729401863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [is_late] = 0&#13;&#10;       AND [order_status] = &apos;delivered&apos;&#13;&#10;    THEN [order_id]&#13;&#10;    END&#13;&#10;) /  COUNTD( &#13;&#10;    IF [order_status] = &quot;delivered&quot; &#13;&#10;    THEN [order_id (delivery_performance.csv)]&#13;&#10;    END)' />
      </column>
      <column caption='OTIF_target' datatype='real' name='[Calculation_1895895756922894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Round(WINDOW_AVG([Calculation_1895895729401863]),1) + 0.05'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivery Status' datatype='string' name='[Calculation_1895895780061201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_late] = 1 THEN &quot;Late&quot;&#13;&#10;ELSE &quot;On Time&quot;&#13;&#10;END' />
      </column>
      <column caption='Bad Review Rate' datatype='real' name='[Calculation_1895895782240274]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [&quot;review_score&quot;] &lt;= 2 THEN [order_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id])' />
      </column>
      <column aggregation='None' caption='Delivery Days (bin)' datatype='integer' name='[Delivery Days (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[delivery_days]' peg='0' size='5' />
      </column>
