              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM(&#13;&#10;        IF [order_status] = &quot;delivered&quot;&#13;&#10;        THEN [price]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
